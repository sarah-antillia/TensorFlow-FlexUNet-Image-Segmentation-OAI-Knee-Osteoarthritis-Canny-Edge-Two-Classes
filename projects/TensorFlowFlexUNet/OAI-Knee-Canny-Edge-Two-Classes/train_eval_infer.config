; train_eval_infer.config
; 2026/10/07 (C) antillia.com

; OAI-Knee-Canny-Edge-Two-Classes segmentation
[model]
model         = "TensorFlowFlexUNet"
generator     =  False

image_width    = 256
image_height   = 256
image_channels = 3
input_normalize = True
normalization  = False
num_classes    = 3
base_filters   = 16
base_kernels   = (9,9)

num_layers     = 8
dropout_rate   = 0.04
dilation       = (3,3)

; Model compilation parameters
optimizer       = "Adam"

learning_rate  = 0.00007
clipvalue      = 0.4

;loss           = "categorical_crossentropy"
;2026/09/23  Modified to use "categorical_focal_dice_loss"
loss           = "categorical_focal_dice_loss"

;metrics        = ["dice_coef_multiclass"]
;2026/09/25 Modified to use "dice_coef_hybrid".
metrics        = ["dice_coef_hybrid"]
hybrid_alpha   = 1.6
hybrid_beta    = 0.4

show_summary   = False

[dataset]
class_name    = "ImageCategorizedMaskDataset"

[train]
;epochs       = 50
epochs        = 100
batch_size    = 4

;steps_per_epoch  = 200
;validation_steps = 80

; EarlyStopping parameter
patience      = 10

; 2026/09/23 Modified the following line.
; metrics       = ["dice_coef_multiclass", "val_dice_coef_multiclass]
metrics       = ["dice_coef_hybrid", "val_dice_coef_hybrid"]

model_dir     = "./models/"
eval_dir      = "./eval/"
images_dir    = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/train/images/"
masks_dir     = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/train/masks/"

create_backup  = False

; learning_rate_reducer callback parameter
learning_rate_reducer = True
reducer_factor     = 0.5
reducer_patience   = 4

; Model saving option
save_weights_only  = True

[valid]
images_dir = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/valid/images/"
masks_dir  = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/valid/masks/"

[test] 
images_dir = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/test/images/"
masks_dir  = "../../../dataset/OAI-Knee-Canny-Edge-Two-Classes/test/masks/"

[infer] 
images_dir    = "./mini_test/images/"
output_dir    = "./mini_test_output/"

[image]
color_order = "RGB"

[mask]
mask_datatyoe    = "categorized"
mask_file_format = ".png"
;Knee-X-Ray RGB color map dict for 1+2 classes.
; RGB_COLORS = {"Doubtful_or_Mild":(0,255,0), "Moderate_or_Severe":(180,20,20)}
rgb_map = {(0,0,0):0,(0,255,0):1, (180,20,20):2}


